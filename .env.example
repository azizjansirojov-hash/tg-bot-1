# Telegram Bot API token from @BotFather
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection string (asyncpg driver required)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Local compose defaults (postgres/postgres) are for DEVELOPMENT ONLY — change for any non-local use.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tgbot

# Private storage channel ID where videos live (bot must be admin)
# Format: -100XXXXXXXXXX
STORAGE_CHANNEL_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to manage content
ADMIN_IDS=123456789,987654321

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Bot run mode: "polling" for local development, "webhook" for production
BOT_MODE=polling

# --- Webhook settings (required only when BOT_MODE=webhook) ---
# Public HTTPS base URL of your deployment (no trailing slash)
WEBHOOK_URL=https://your-app.up.railway.app

# Path appended to WEBHOOK_URL for Telegram updates
WEBHOOK_PATH=/webhook

# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token header.
# REQUIRED when BOT_MODE=webhook: at least 32 characters, not a known weak default.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Port the HTTP server listens on (Railway/Render set this automatically)
PORT=8080

# --- Rate limiting: code lookups (digit-only messages, non-admins) ---
# Max code requests per user within the time window
RATE_LIMIT_MAX_REQUESTS=5
# Time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# --- Rate limiting: global ceiling (ALL update types, including admins) ---
# Process-protection limit applied to every user including admins
RATE_LIMIT_GLOBAL_MAX_REQUESTS=60
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# --- Abuse signal (WARNING log when a user is blocked repeatedly) ---
# Fire WARNING after this many rate-limit blocks within the abuse window
RATE_LIMIT_ABUSE_THRESHOLD=10
RATE_LIMIT_ABUSE_WINDOW_SECONDS=300

# Cap tracked users in the in-memory rate limiter (ignored when USE_REDIS=true)
RATE_LIMIT_MAX_TRACKED_USERS=10000

# --- Database connection pool (async SQLAlchemy / asyncpg) ---
# Base number of connections kept in the pool
DB_POOL_SIZE=5
# Extra connections allowed above pool_size under burst load
DB_MAX_OVERFLOW=10
# Seconds to wait for a free connection before timing out
DB_POOL_TIMEOUT=30
# Recycle connections after this many seconds (avoids stale server disconnects)
DB_POOL_RECYCLE=1800

# --- Redis (shared FSM + rate limits for multi-replica deployments) ---
# Leave USE_REDIS=false for single-instance local/dev (MemoryStorage + in-memory limits).
# Set USE_REDIS=true and REDIS_URL before running more than one bot replica.
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
